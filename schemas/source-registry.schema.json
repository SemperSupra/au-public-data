{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AU Public Data Source Registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {"$ref": "source.schema.json"}
    }
  },
  "additionalProperties": false
}
